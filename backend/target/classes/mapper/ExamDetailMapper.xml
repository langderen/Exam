<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exercise.mapper.ExamDetailMapper">
    
    <resultMap id="BaseResultMap" type="com.exercise.entity.ExamDetail">
        <id column="id" property="id"/>
        <result column="exam_id" property="examId"/>
        <result column="question_id" property="questionId"/>
        <result column="user_answer" property="userAnswer"/>
        <result column="is_correct" property="isCorrect"/>
    </resultMap>
    
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO exam_detail (exam_id, question_id, user_answer, is_correct)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.examId}, #{item.questionId}, #{item.userAnswer}, #{item.isCorrect})
        </foreach>
    </insert>
    
    <select id="selectByExamId" resultMap="BaseResultMap">
        SELECT * FROM exam_detail WHERE exam_id = #{examId}
    </select>
</mapper>

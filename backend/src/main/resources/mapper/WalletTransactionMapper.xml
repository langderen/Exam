<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exercise.mapper.WalletTransactionMapper">
    
    <resultMap id="BaseResultMap" type="com.exercise.entity.WalletTransaction">
        <id column="id" property="id"/>
        <result column="wallet_id" property="walletId"/>
        <result column="type" property="type"/>
        <result column="amount" property="amount"/>
        <result column="balance_after" property="balanceAfter"/>
        <result column="description" property="description"/>
        <result column="related_id" property="relatedId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    
    <select id="selectByWalletId" resultMap="BaseResultMap">
        SELECT * FROM wallet_transaction 
        WHERE wallet_id = #{walletId}
        ORDER BY create_time DESC
    </select>
    
    <select id="selectByWalletIdWithType" resultMap="BaseResultMap">
        SELECT * FROM wallet_transaction 
        WHERE wallet_id = #{walletId} AND type = #{type}
        ORDER BY create_time DESC
    </select>
    
    <insert id="insert" parameterType="com.exercise.entity.WalletTransaction" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wallet_transaction (wallet_id, type, amount, balance_after, description, related_id, create_time)
        VALUES (#{walletId}, #{type}, #{amount}, #{balanceAfter}, #{description}, #{relatedId}, #{createTime})
    </insert>
</mapper>
